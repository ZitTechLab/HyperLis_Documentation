---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="landing-custom-footer not-content">
  <div class="footer-container">
    <div class="footer-left">
      <span class="copyright-text">
        © 2026 <a href="https://www.facebook.com/ZitTechLab/" target="_blank" rel="noopener noreferrer" class="footer-brand-link">Zịt's Tech Lab</a>. All rights reserved.
      </span>
    </div>
    <div class="footer-right">
      <a href="?uwu=true" class="footer-link" id="uwu-toggle-link" title="wanna UwU">UwU</a>
    </div>
  </div>
</footer>

<style>
  .landing-custom-footer {
    width: 100%;
    border-top: 1px solid var(--sl-color-hairline);
    background: transparent;
    padding: 0.65rem 3rem;
    margin-top: 0.5rem;
    box-sizing: border-box;
  }

  .footer-container {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .landing-custom-footer {
      padding: 0.65rem 1.25rem;
    }
  }

  .footer-left,
  .footer-right {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .copyright-text,
  .footer-link {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
    margin: 0;
    padding: 0;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
  }

  .footer-brand-link {
    color: var(--sl-color-gray-2);
    font-weight: 500;
    text-decoration: underline !important;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
    margin: 0 0.2rem;
  }

  .footer-brand-link:hover {
    color: var(--sl-color-accent);
  }

  .footer-link {
    text-decoration: none;
    transition: color 0.15s ease;
    cursor: pointer;
  }

  .footer-link:hover {
    color: var(--sl-color-accent);
    text-decoration: underline;
  }
</style>
