---
const lang = Astro.currentLocale || 'vi';

const i18n = {
  vi: {
    sectionTitle: 'Tất cả những gì bạn cần để làm chủ Windows',
    features: [
      {
        icon: '🚀',
        title: 'Tối ưu hiệu năng chuyên sâu',
        desc: 'Kích hoạt Ultimate Power Plan, tối ưu hóa MMCSS, tắt bóp băng thông mạng (Throttling) và tối ưu độ trễ game.'
      },
      {
        icon: '🧹',
        title: 'Dọn dẹp & Gỡ bỏ Bloatware',
        desc: 'Gỡ sạch các ứng dụng Microsoft rác cài sẵn theo Preset an toàn, dọn dẹp RAM Standby List và rác trình duyệt.'
      },
      {
        icon: '⚡',
        title: 'Quản lý Khởi chạy (Startup)',
        desc: 'Kiểm soát các ứng dụng tự động khởi động cùng Windows, quét sâu Task Scheduler kèm cơ chế Sao lưu / Khôi phục an toàn.'
      },
      {
        icon: '🌐',
        title: 'Mạng & Chẩn đoán siêu tốc',
        desc: 'Tra cứu thông số card mạng, chuyển đổi nhanh DNS Cloudflare (1.1.1.1) / Google và công cụ Ping Tool kiểm tra giật lag.'
      },
      {
        icon: '💾',
        title: 'USB Boot & Triển khai WSAP',
        desc: 'Tạo USB Boot cài đặt Windows 10/11 tự động bỏ qua TPM 2.0 / Secure Boot và công cụ cài Windows tự động WSAP.'
      },
      {
        icon: '🖨️',
        title: 'Sửa lỗi Windows & Bản quyền',
        desc: 'Sửa triệt để lỗi chia sẻ máy in mạng LAN (0x0000011b, 0x00000709), quét lỗi tệp SFC/DISM và quản trị bản quyền số.'
      }
    ]
  },
  en: {
    sectionTitle: 'Everything you need to master Windows',
    features: [
      {
        icon: '🚀',
        title: 'Deep Performance Optimization',
        desc: 'Activate Ultimate Power Plan, optimize MMCSS, disable network throttling, and optimize game latency.'
      },
      {
        icon: '🧹',
        title: 'Clean Up & Remove Bloatware',
        desc: 'Cleanly uninstall pre-installed Microsoft junk apps via safe Presets, clean RAM Standby List and browser junk.'
      },
      {
        icon: '⚡',
        title: 'Startup Management',
        desc: 'Control apps that start automatically with Windows, deep scan Task Scheduler with safe Backup/Restore mechanisms.'
      },
      {
        icon: '🌐',
        title: 'Network & Diagnostics',
        desc: 'Lookup network card specs, quickly switch to Cloudflare/Google DNS, and check for lag using the Ping Tool.'
      },
      {
        icon: '💾',
        title: 'USB Boot & WSAP Deployment',
        desc: 'Create Windows 10/11 USB Boot bypassing TPM 2.0 / Secure Boot, and automate Windows installation with WSAP.'
      },
      {
        icon: '🖨️',
        title: 'Fix Windows Errors & Licenses',
        desc: 'Completely fix LAN printer sharing errors (0x0000011b, 0x00000709), scan SFC/DISM files, and manage digital licenses.'
      }
    ]
  }
};
const t = i18n[lang] || i18n['vi'];
---

<section class="feature-section not-content">
  <div class="section-header">
    <h2 class="section-title">{t.sectionTitle}</h2>
  </div>

  <div class="features-grid">
    {t.features.map((item) => (
      <div class="feature-card">
        <div class="feature-icon-wrapper">
          <span class="feature-icon">{item.icon}</span>
        </div>
        <h3 class="feature-card-title">{item.title}</h3>
        <p class="feature-card-desc">{item.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .feature-section {
    max-width: 1440px;
    margin: 0 auto;
    padding: 2.25rem 3rem;
  }

  @media (max-width: 640px) {
    .feature-section {
      padding: 1.75rem 1.25rem;
    }
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 2.25rem auto;
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    margin-bottom: 0;
    line-height: 1.25;
  }

  .section-subtitle {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 1fr;
    gap: 1.5rem;
    align-items: stretch;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 1fr;
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
  }

  .features-grid > .feature-card,
  .feature-card {
    margin: 0 !important;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--sl-color-accent);
    box-shadow: var(--hl-shadow-md);
  }

  .feature-icon-wrapper {
    width: 44px;
    height: 44px;
    background: rgba(14, 165, 233, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .feature-icon {
    font-size: 1.35rem;
  }

  .feature-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .feature-card-desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    margin: 0;
    flex: 1 1 auto;
  }
</style>
