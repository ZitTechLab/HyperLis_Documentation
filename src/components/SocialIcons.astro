---
import config from 'virtual:starlight/user-config';

type Platform = keyof NonNullable<typeof config.social>;
type SocialConfig = NonNullable<NonNullable<typeof config.social>[Platform]>;
const links = Object.entries(config.social || {}) as [Platform, SocialConfig][];
---

<div class="social-icons-wrapper">
  {links.map(([platform, { label, url }]) => (
    <a 
      href={url} 
      target="_blank" 
      rel="noopener noreferrer" 
      class={`social-link ${platform}`}
      title={label}
      aria-label={label}
    >
      {platform === 'facebook' ? (
        <!-- Modern Circular Facebook Badge Icon -->
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="social-svg">
          <path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/>
        </svg>
      ) : platform === 'github' ? (
        <!-- Modern GitHub Icon -->
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="social-svg">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      ) : (
        <span class="generic-label">{label}</span>
      )}
    </a>
  ))}
</div>

<style>
  .social-icons-wrapper {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-3);
    transition: color 0.15s ease, background-color 0.15s ease, transform 0.15s ease;
    text-decoration: none !important;
  }

  .social-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-7);
    transform: translateY(-1px);
  }

  .social-link.facebook:hover {
    color: #1877f2;
  }

  .social-svg {
    display: block;
    transition: transform 0.15s ease;
  }
</style>
